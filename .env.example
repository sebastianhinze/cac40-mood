# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM scoring ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Stronger model used only on small subsamples as a reference for the cheap model's scores.
LLM_REFERENCE_MODEL=claude-sonnet-5-5
# Hard cap on total API spend for the whole project (USD). Code must refuse to send a request once the
# running total (logged in data/cache/llm/spend.jsonl) plus this request's worst-case cost would exceed it.
LLM_SPEND_CAP_USD=30
# Number of documents to pilot a new/changed prompt on before any bulk run.
LLM_PILOT_SIZE=20
# Max input tokens of document text per call (longer docs are truncated; truncation is logged).
LLM_MAX_DOC_TOKENS=12000

# --- Data ---
SAMPLE_START=2019-01-01
SAMPLE_END=2025-12-31
# Polite identifier sent to public data servers (generic, no personal details needed).
HTTP_USER_AGENT=cac40-mood-research/0.1
HTTP_MIN_SECONDS_BETWEEN_REQUESTS=0.5
